{
  "_comment": "复制到项目根目录 .codebuddy/settings.local.json 或全局 ~/.codebuddy/settings.json",
  "_note": "请将 TRAFFIC_LIGHT_DIR 替换为 traffic-light 目录的实际路径，或把 hooks/traffic-light.sh 复制到项目 .codebuddy/hooks/ 下",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "TRAFFIC_LIGHT_LAUNCH session-start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "TRAFFIC_LIGHT_LAUNCH prompt"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "TRAFFIC_LIGHT_LAUNCH tool"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "TRAFFIC_LIGHT_LAUNCH notify"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "TRAFFIC_LIGHT_LAUNCH stop"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "TRAFFIC_LIGHT_LAUNCH end"
          }
        ]
      }
    ]
  }
}